# Copy this to .env and fill in your values
# Never commit .env to git

# Primary model. Falls back to OpenAI automatically if this call fails
# (sunset model, outage, rate limit, etc.).
ANTHROPIC_API_KEY=sk-ant-...

# Fallback model. Optional, but strongly recommended so a Claude outage or
# model deprecation doesn't break the weekly digest.
OPENAI_API_KEY=sk-...

# Optional: override the default model IDs used for each provider.
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5.5

RESEND_API_KEY=re_...

# Must be a verified domain in your Resend dashboard
FROM_EMAIL=digest@yourdomain.com

# Comma-separated, no spaces around commas
TO_EMAILS=you@example.com,friend@example.com

# Optional: override default topics
TOPICS=LLMs, AI agents, ML research, AI policy, open-source AI
